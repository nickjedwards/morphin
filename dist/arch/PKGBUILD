# Maintainer: Nick Edwards <nick@endever.com.au>
#
# Builds from the latest commit.

_name=morphin
pkgname=${_name}-git
pkgver=r0
pkgrel=1
pkgdesc="A morphing-island shell for Hyprland, it's morphin' time!"
arch=('any')
url="https://github.com/nickjedwards/${_name}"
license=('GPL-3.0-only')
depends=(
    'quickshell'
    'qt6-declarative'
    'qt6-imageformats'
    'ttf-nerd-fonts-symbols'
    'networkmanager'
    'bluez'
    'pipewire'
    'wireplumber'
    'upower'
    'brightnessctl'
)
optdepends=(
    'hyprland: workspaces, focus, game mode, monitor settings'
    'hyprpaper: draws the wallpaper (the shell draws it itself otherwise)'
    'hyprsunset: night light'
    'power-profiles-daemon: power mode'
    'cava: audio pulse around the album art'
    'ddcutil: brightness for external monitors'
    'playerctl: play/pause for players that report no controls'
    'curl: colours from cover art served over https'
)
makedepends=('git' 'make')
provides=("${_name}")
conflicts=("${_name}")
source=("${_name}::git+${url}.git#branch=main")
sha256sums=('SKIP')

pkgver() {
    cd "${_name}"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

package() {
    cd "${_name}"
    make DESTDIR="${pkgdir}" PREFIX=/usr NAME="${_name}" install
}
