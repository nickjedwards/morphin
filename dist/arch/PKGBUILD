# Maintainer: Nick Edwards <nick@endever.com.au>
#
# Builds from the latest commit.

_pkgname=morphin
pkgname=${_pkgname}-git
pkgver=r0
pkgrel=1
pkgdesc="A morphing-island shell for Hyprland, it's morphin' time!"
arch=("any")
url="https://github.com/nickjedwards/${_pkgname}"
license=('GPL-3.0-only')
depends=(
    'bluez'
    'brightnessctl'
    'networkmanager'
    'pipewire'
    'qt6-declarative'
    'qt6-imageformats'
    'quickshell'
    'ttf-nerd-fonts-symbols'
    'upower'
    'wireplumber'
)
optdepends=(
    'cava'
    'curl'
    'hyprland'
    'hyprpaper'
    'hyprsunset'
    'playerctl'
    'power-profiles-daemon'
)
makedepends=('git')
provides=("${_pkgname}")
conflicts=("${_pkgname}")
source=("${_pkgname}::git+${url}.git#branch=main")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/${_pkgname}"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

package() {
    cd "$srcdir/${_pkgname}"
    make DESTDIR="${pkgdir}" PREFIX=/usr NAME="${_pkgname}" install
}
