[Unit]
Description=@NAME@, a morphing-island shell for Hyprland. It's morphin' time!
Documentation=file://@DOCDIR@/README.md
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=exec
ExecStart=@BINDIR@/@BIN@ its-morphin-time --stay
Restart=on-failure
RestartSec=1
# Desktop shells belong in session.slice, alongside the compositor.
Slice=session.slice

[Install]
WantedBy=graphical-session.target
